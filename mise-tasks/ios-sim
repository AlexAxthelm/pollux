#!/usr/bin/env bash
#MISE description="Build, install and launch in the simulator (blocks on the launch console)"
#MISE depends=["ios-xcodebuild"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
source scripts/ios-env.sh

[ -d "$APP_PATH" ] || { echo "App not found at $APP_PATH."; exit 1; }
SIM_ID="$(sim_id)"

echo "Targeting: $SIM_DEVICE_NAME ($SIM_ID)"
echo "Installing: $APP_PATH"
xcrun simctl boot "$SIM_ID" 2>/dev/null || true
open -a Simulator
xcrun simctl install "$SIM_ID" "$APP_PATH"
xcrun simctl launch --console "$SIM_ID" "$(bundle_id "$APP_PATH")"
